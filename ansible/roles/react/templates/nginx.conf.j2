# Managed by Ansible. React SPA routing is handled by try_files.
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;

    root {{ nginx_web_root }};
    index index.html;

    access_log /var/log/nginx/react-app.access.log;
    error_log  /var/log/nginx/react-app.error.log;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|mjs|json|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }
}
