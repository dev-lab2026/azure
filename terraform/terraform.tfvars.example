# Copy this file to terraform.tfvars and adapt it.
# Never commit real credentials or private keys.

project_name          = "reactcicd"
environment           = "prod"
location              = "West Europe"
resource_group_name   = ""
vm_size               = "Standard_B2s"
admin_username        = "azureadmin"
allowed_ssh_cidr      = "203.0.113.10/32"

# Replace with the content of your public key:
# ssh_public_key = "ssh-ed25519 AAAA... user@machine"

ssh_public_key = "REPLACE_ME"
